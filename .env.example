# OpenDialer server environment – copy to .env / your service definition and adjust.
# Everything has a sensible default; most installs need none of this.
# Full list: docs/DEPLOYMENT.md section 4.

# PORT=8080
# HTTPS_PORT=8443
# DATA_DIR=/var/lib/opendialer
# JWT_SECRET=
# LOG_LEVEL=info

# --- Predictive dialing (docs/PREDICTIVE.md) ---
# Off unless PREDICTIVE_ENABLED=true AND AMI_USER/AMI_SECRET are set.
# Use a dedicated, permit-restricted AMI account; never expose TCP 5038
# to the public internet.
PREDICTIVE_ENABLED=false
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=opendialer-dialer
AMI_SECRET=
# Dial-string prefix for customer legs (phone number is appended).
# Dongle/r0/ = chan_dongle round-robin over group 0.
DIALER_CHANNEL_PREFIX=Dongle/r0/
